<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('EcoGPU.ico')">EcoGPU.ico</ApplicationIcon>
    <AssemblyName>EcoGPU</AssemblyName>
    <RootNamespace>EcoGPU</RootNamespace>
    <Version>1.0.0</Version>
    <Product>EcoGPU</Product>
    <Description>Turns off the discrete GPU on battery, back on when plugged in.</Description>
    <Copyright>MIT License</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
